def product_from_index(
    alphabet,
    length,
    index,
):

    if not alphabet:
        return ()

    base = len(alphabet)

    result = [None] * length

    for position in range(
        length - 1,
        -1,
        -1,
    ):

        result[position] = alphabet[
            index % base
        ]

        index //= base

    return tuple(result)

class TraversalStrategy(ABC):
    """
    Base class for every traversal strategy.
    """

    def __init__(
        self,
        alphabet,
        length,
        state=None,
    ):

        self.alphabet = list(
            dict.fromkeys(
                alphabet
            )
        )

        self.length = length

        if isinstance(
            state,
            dict,
        ):
            self.state = state
        else:
            self.state = {}

    def export_state(self):

        return {
            "index": self.state.get(
                "index",
                0,
            )
        }

    def import_state(
        self,
        state,
    ):

        if not isinstance(
            state,
            dict,
        ):
            self.state = {}
            return

        self.state = state

    @abstractmethod
    def __iter__(self):
        pass


class SequentialTraversal(TraversalStrategy):
    """
    Sequential traversal.
    """

    def __init__(
        self,
        alphabet,
        length,
        state=None,
    ):

        super().__init__(
            alphabet,
            length,
            state,
        )

    def __iter__(self):

        total = len(
            self.alphabet
        ) ** self.length

        start_index = self.state.get(
            "index",
            0,
        )

        for index in range(
            start_index,
            total,
        ):

            candidate = "".join(
                product_from_index(
                    self.alphabet,
                    self.length,
                    index,
                )
            )

            self.state["index"] = (
                index + 1
            )

            yield candidate

        self.state["index"] = 0

class AlphabeticalTraversal(TraversalStrategy):
    """
    Alphabetical traversal.
    """

    def __init__(
        self,
        alphabet,
        length,
        state=None,
    ):

        super().__init__(
            alphabet,
            length,
            state,
        )

    def __iter__(self):

        ordered = sorted(
            self.alphabet
        )

        total = len(
            ordered
        ) ** self.length

        start_index = self.state.get(
            "index",
            0,
        )

        for index in range(
            start_index,
            total,
        ):

            candidate = "".join(
                product_from_index(
                    ordered,
                    self.length,
                    index,
                )
            )

            self.state["index"] = (
                index + 1
            )

            yield candidate

        self.state["index"] = 0


class RandomTraversal(TraversalStrategy):
    """
    Random traversal.
    """

    def __init__(
        self,
        alphabet,
        length,
        state=None,
    ):

        super().__init__(
            alphabet,
            length,
            state,
        )

    def __iter__(self):

        total = len(
            self.alphabet
        ) ** self.length

        if total <= 0:
            return

        indices = list(
            range(total)
        )

        random.shuffle(
            indices
        )

        start_index = self.state.get(
            "index",
            0,
        )

        for position in range(
            start_index,
            total,
        ):

            index = indices[position]

            candidate = "".join(
                product_from_index(
                    self.alphabet,
                    self.length,
                    index,
                )
            )

            self.state["index"] = (
                position + 1
            )

            yield candidate

        self.state["index"] = 0

class RotationTraversal(TraversalStrategy):
    """
    Rotation-based traversal.
    """

    def __init__(
        self,
        alphabet,
        length,
        state=None,
    ):

        super().__init__(
            alphabet,
            length,
            state,
        )

    def __iter__(self):

        seen = set()

        queue = deque()

        start_index = self.state.get(
            "index",
            0,
        )

        # -----------------------------
        # Seed
        # -----------------------------

        for char in self.alphabet:

            if len(char) <= self.length:

                queue.append(char)

        # -----------------------------
        # Traverse
        # -----------------------------

        yielded = 0

        while queue:

            current = queue.popleft()

            if current in seen:
                continue

            seen.add(current)

            # -------------------------
            # Target length
            # -------------------------

            if len(current) == self.length:

                if yielded < start_index:

                    yielded += 1

                    continue

                yielded += 1

                self.state["index"] = (
                    yielded
                )

                yield current

                continue

            children = []

            # -------------------------
            # Rotations
            # -------------------------

            if len(current) > 1:

                for i in range(
                    1,
                    len(current),
                ):

                    rotated = (
                        current[i:]
                        + current[:i]
                    )

                    if len(rotated) <= self.length:

                        children.append(
                            rotated
                        )

            # -------------------------
            # Append
            # -------------------------

            for char in self.alphabet:

                child = (
                    current + char
                )

                if len(child) <= self.length:

                    children.append(
                        child
                    )

            # -------------------------
            # Prepend
            # -------------------------

            for char in self.alphabet:

                child = (
                    char + current
                )

                if len(child) <= self.length:

                    children.append(
                        child
                    )

            # -------------------------
            # Remove duplicates
            # -------------------------

            unique = []

            local = set()

            for child in children:

                if child in local:
                    continue

                if child in seen:
                    continue

                local.add(child)

                unique.append(child)

            # -------------------------
            # Ordering
            # -------------------------

            unique.sort(
                key=lambda word: (
                    len(set(word)),
                    sum(
                        word[i] != word[i - 1]
                        for i in range(
                            1,
                            len(word),
                        )
                    ),
                    -max(
                        word.count(char)
                        for char in set(word)
                    ),
                ),
                reverse=True,
            )

            queue.extend(
                unique
            )


class PriorityTraversal(TraversalStrategy):
    """
    Priority-based traversal.
    """

    def __init__(
        self,
        alphabet,
        length,
        state=None,
    ):

        super().__init__(
            alphabet,
            length,
            state,
        )

        self.ranker = Ranker()

    def __iter__(self):

        frontier = []

        visited = set()

        start_index = self.state.get(
            "index",
            0,
        )

        # -----------------------------
        # Seed
        # -----------------------------

        for char in self.alphabet:

            if len(char) <= self.length:

                score = self.ranker.score(
                    char
                )

                heapq.heappush(
                    frontier,
                    (
                        -score,
                        char,
                    ),
                )

        generated = 0

        # -----------------------------
        # Traverse
        # -----------------------------

        while frontier:

            negative_score, current = (
                heapq.heappop(
                    frontier
                )
            )

            if current in visited:
                continue

            visited.add(current)

            # -------------------------
            # Target length
            # -------------------------

            if len(current) == self.length:

                if generated < start_index:

                    generated += 1

                else:

                    generated += 1

                    self.state["index"] = (
                        generated
                    )

                    yield current

                continue

            # -------------------------
            # Generate children
            # -------------------------

            children = []

            # Append

            for char in self.alphabet:

                child = (
                    current + char
                )

                if len(child) <= self.length:

                    children.append(
                        child
                    )

            # Prepend

            for char in self.alphabet:

                child = (
                    char + current
                )

                if len(child) <= self.length:

                    children.append(
                        child
                    )

            # Insert

            for char in self.alphabet:

                for position in range(
                    len(current) + 1
                ):

                    child = (
                        current[:position]
                        + char
                        + current[position:]
                    )

                    if len(child) <= self.length:

                        children.append(
                            child
                        )

            # Rotations

            if len(current) > 1:

                for position in range(
                    1,
                    len(current),
                ):

                    child = (
                        current[position:]
                        + current[:position]
                    )

                    if len(child) <= self.length:

                        children.append(
                            child
                        )

            # -------------------------
            # Queue children
            # -------------------------

            local = set()

            for child in children:

                if child in visited:
                    continue

                if child in local:
                    continue

                local.add(child)

                score = self.ranker.score(
                    child
                )

                heapq.heappush(
                    frontier,
                    (
                        -score,
                        child,
                    ),
                )

        self.state["index"] = 0



