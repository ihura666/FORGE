            "english": 6000,

            "digits": 3000,

            "symbols": 3000,

            "runs": 2000,

        }

        self.keyboard_rows = [

            "qwertyuiop",

            "asdfghjkl",

            "zxcvbnm",

        ]

        self.common_pairs = {

            "th",
            "he",
            "in",
            "er",
            "an",
            "re",
            "nd",
            "on",
            "en",
            "at",
            "ou",
            "ed",
            "ha",
            "to",
            "or",
            "it",
            "is",
            "hi",
            "es",
            "ng",

        }

        self.common_triples = {

            "the",
            "ing",
            "ion",
            "ent",
            "and",
            "her",
            "for",
            "tha",
            "ere",
            "ter",

        }

    @staticmethod
    def score(word):

        if not word:

            return 0

        # -----------------------------
        # Character diversity
        # -----------------------------

        unique = len(
            set(word)
        )

        # -----------------------------
        # Character transitions
        # -----------------------------

        transitions = sum(
            word[i] != word[i - 1]
            for i in range(
                1,
                len(word),
            )
        )

        # -----------------------------
        # Repeated-character runs
        # -----------------------------

        runs = max(
            (
                word.count(char)
                for char in set(word)
            ),
            default=0,
        )

        # -----------------------------
        # Alternation
        # -----------------------------

        alternating = sum(
            word[i] != word[i + 1]
            for i in range(
                len(word) - 1,
            )
        )

        # -----------------------------
        # Vowels
        # -----------------------------

        vowels = sum(
            char.lower() in "aeiou"
            for char in word
        )

        # -----------------------------
        # Digits
        # -----------------------------

        digits = sum(
            char.isdigit()
            for char in word
        )

        # -----------------------------
        # Symbols
        # -----------------------------

        symbols = sum(
            not char.isalnum()
            for char in word
        )

        # -----------------------------
        # Entropy-style diversity
        # -----------------------------

        entropy = (
            unique * unique
        )

        # -----------------------------
        # Final score
        # -----------------------------

        return (

            entropy * 100000

            + transitions * 20000

            + alternating * 10000

            + digits * 3000

            + symbols * 3000

            + vowels * 500

            - runs * 2000

        )


def build_exhaustive_candidates(
    alphabet,
    minimum_length,
    maximum_length,
    include_numbers,
    include_symbols,
    max_candidates,
    existing_candidates,
    state,
    repeat_patterns,
    insert_numbers,
    traversal,
):

    if not alphabet:
        return

    alphabet_items = [
        item.strip()
        for item in alphabet
        if item.strip()
    ]

    if include_numbers:

        alphabet_items.extend(
            str(i)
            for i in range(10)
        )

    if include_symbols:

        alphabet_items.extend([
            "@",
            ".",
            "!",
            "#",
            "$",
            "%",
            "&",
            "-",
        ])

    alphabet_items = list(
        dict.fromkeys(
            alphabet_items
        )
    )

    if not alphabet_items:
        return

    # ---------------------------------
    # Generation tracking
    # ---------------------------------

    seen = set()

    generated = 0

    # ---------------------------------
    # Resume length
    # ---------------------------------

    start_length = state.get(
        "length",
        minimum_length,
    )

    if not isinstance(
        start_length,
        int,
    ):

        start_length = minimum_length

    if start_length < minimum_length:

        start_length = minimum_length

    # ---------------------------------
    # Resume traversal state
    # ---------------------------------

    traversal_state = state.get(
        "traversal_state",
        {},
    )

    if not isinstance(
        traversal_state,
        dict,
    ):

        traversal_state = {}

    # ---------------------------------
    # Generate each length
    # ---------------------------------

    for length in range(
        start_length,
        maximum_length + 1,
    ):

        state["length"] = length

        # ---------------------------------
        # Reset traversal position when
        # moving to a new length
        # ---------------------------------

        if length != start_length:

            traversal_state = {}

        # ---------------------------------
        # Select traversal engine
        # ---------------------------------

        if traversal == "rotation":

            source = RotationTraversal(
                alphabet_items,
                length,
                traversal_state,
            )

        elif traversal == "alphabetical":

            source = AlphabeticalTraversal(
                alphabet_items,
                length,
                traversal_state,
            )

        elif traversal == "random":

            source = RandomTraversal(
                alphabet_items,
                length,
                traversal_state,
            )

        elif traversal == "priority":

            source = PriorityTraversal(
                alphabet_items,
                length,
                traversal_state,
            )

        else:

            source = SequentialTraversal(
                alphabet_items,
                length,
                traversal_state,
            )

        # ---------------------------------
        # Traverse candidates
        # ---------------------------------

        for candidate in source:

            if not isinstance(
                candidate,
                str,
            ):

                candidate = str(
                    candidate
                )

            if candidate in seen:
                continue

            if candidate in existing_candidates:
                continue

            if len(candidate) != length:
                continue

            seen.add(candidate)

            generated += 1

            # ---------------------------------
            # Save traversal position
            # ---------------------------------

            state["traversal_state"] = (
                source.export_state()
            )

            yield candidate

            # ---------------------------------
            # Maximum generation limit
            # ---------------------------------

            if generated >= max_candidates:

                state["length"] = length

                state["traversal_state"] = (
                    source.export_state()
                )

                return

            # ---------------------------------
            # Repeated patterns
            # ---------------------------------

            if repeat_patterns:

                repeated = candidate

                while (
                    len(repeated)
                    < maximum_length
                ):

                    repeated += candidate

                    if (
                        len(repeated)
                        > maximum_length
                    ):
                        break

                    if repeated in seen:
                        break

                    if (
                        repeated
                        in existing_candidates
                    ):
                        break

                    seen.add(repeated)

                    generated += 1

                    yield repeated

                    if (
                        generated
                        >= max_candidates
                    ):

                        state["length"] = length

                        state["traversal_state"] = (
                            source.export_state()
                        )

                        return

        # ---------------------------------
        # Current length completed
        # ---------------------------------

        state["traversal_state"] = {}

        state["length"] = length + 1

    # ---------------------------------
    # Everything completed
    # ---------------------------------

    state["length"] = minimum_length

    state["traversal_state"] = {}


def parse_list(raw_value: str) -> list[str]:
    if not raw_value.strip():
        return []
    return [part.strip() for part in raw_value.split(",") if part.strip()]


def is_valid_email(candidate: str) -> bool:
    candidate = candidate.strip().lower()
    if not candidate or "@" not in candidate:
        return False
    local, domain = candidate.split("@", 1)
    if not local or not domain:
        return False
    if not re.fullmatch(r"[a-z0-9._-]+", local):
        return False
    if "." not in domain:
        return False
    domain_parts = domain.split(".")
    if len(domain_parts) < 2:
        return False
    if any(not part for part in domain_parts):
        return False
    if any(not re.fullmatch(r"[a-z0-9-]+", part) for part in domain_parts):
        return False
    return True



def build_email_candidates(
    keywords: list[str],
    numbers: list[str],
    symbols: list[str],
    domains: list[str],
    max_candidates: int,
    minimum_length: int = 4,
    maximum_length: int = 30,
) -> list[str]:

    if not keywords:
        keywords = ["user"]

    if not domains:
        domains = ["example.com"]

    email_candidates = []
    seen = set()

    def add_candidate(candidate: str):

        if len(email_candidates) >= max_candidates:
            return False

        if not candidate:
            return True

        username, _, domain = candidate.partition("@")

        if not username or not domain:
            return True

        if len(username) < minimum_length:
            return True

        if len(username) > maximum_length:
            return True

        if candidate in seen:
            return True

        seen.add(candidate)
        email_candidates.append(candidate)

        return True


    def limit_reached():
        return len(email_candidates) >= max_candidates


    def expand_forms(base: str):

        cleaned = normalize_word(base)

        if not cleaned:
            return []

        forms = {
            cleaned,
            cleaned.capitalize(),
            cleaned.upper(),
            cleaned.replace(" ", ""),
            cleaned.replace(" ", "_"),
            cleaned.replace(" ", "-"),
        }

        if len(cleaned) <= 6:

            for perm in get_permutations(cleaned):
                forms.add(perm)
                forms.add(perm.capitalize())
                forms.add(perm.upper())

        return list(forms)


    keyword_forms = {}

    for keyword in keywords:
        keyword_forms[keyword] = expand_forms(keyword)


    for keyword in keywords:

        for domain in domains:

            domain = domain.strip().lower()

            if not domain:
                continue


            for form in keyword_forms[keyword]:

                add_candidate(
                    f"{form}@{domain}"
                )

                if limit_reached():
                    return email_candidates


                for num in numbers:

                    add_candidate(
                        f"{form}{num}@{domain}"
                    )

                    if limit_reached():
                        return email_candidates


                    add_candidate(
                        f"{num}{form}@{domain}"
                    )

                    if limit_reached():
                        return email_candidates


                for sym in symbols:

                    add_candidate(
                        f"{form}{sym}@{domain}"
                    )

                    if limit_reached():
                        return email_candidates


                    add_candidate(
                        f"{sym}{form}@{domain}"
                    )

                    if limit_reached():
                        return email_candidates


                for second in keywords:

                    if second == keyword:
                        continue


                    for second_form in keyword_forms[second]:

                        combined = f"{form}{second_form}"

                        add_candidate(
                            f"{combined}@{domain}"
                        )

                        if limit_reached():
                            return email_candidates


                        for num in numbers:

                            add_candidate(
                                f"{combined}{num}@{domain}"
                            )

                            if limit_reached():
                                return email_candidates


                            add_candidate(
                                f"{num}{combined}@{domain}"
                            )

                            if limit_reached():
                                return email_candidates


                        for sym in symbols:

                            add_candidate(
                                f"{combined}{sym}@{domain}"
                            )

                            if limit_reached():
                                return email_candidates


                            add_candidate(
                                f"{sym}{combined}@{domain}"
                            )

                            if limit_reached():
                                return email_candidates


    return email_candidates



def write_candidates(path: Path, candidates: list[str]) -> int:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("", encoding="utf-8")
    with path.open("a", encoding="utf-8") as handle:
        for candidate in candidates:
            handle.write(candidate + "\n")
    return len(candidates)

def append_candidates(
    path,
    candidates,
    state=None,
):

    count = 0

    with Path(path).open(
        "a",
        encoding="utf-8",
    ) as f:

        for candidate in candidates:

            if not isinstance(
                candidate,
                str,
            ):

                candidate = str(
                    candidate
                )

            f.write(
                candidate + "\n"
            )

            count += 1

            if state is not None:

                state["generated_total"] = (
                    state.get(
                        "generated_total",
                        0,
                    ) + 1
                )

    return count

def get_state_path(wordlist: Path) -> Path:
    return wordlist.with_suffix(wordlist.suffix + ".state")


def load_state(wordlist: Path) -> dict:

    state_file = get_state_path(wordlist)

    if not state_file.exists():
        return {
            "keyword": 0,
            "permutation": 0,
        }

    try:
        with state_file.open("r", encoding="utf-8") as f:
            return json.load(f)

    except Exception:
        return {
            "keyword": 0,
            "permutation": 0,
        }


def save_state(wordlist: Path, state: dict):

    state_file = get_state_path(wordlist)

    with state_file.open("w", encoding="utf-8") as f:
        json.dump(state, f)

def load_existing_candidates(path: str) -> set[str]:

    file = Path(path)

    if not file.exists():

        raise FileNotFoundError(
            f"{path} does not exist."
        )

    existing = set()

    with file.open(
        "r",
        encoding="utf-8",
        errors="ignore",
    ) as f:

        for line in f:

            candidate = line.strip()

            if candidate:

                existing.add(candidate)

    print(
        f"Loaded {len(existing):,} existing candidates."
    )

    return existing


def get_state_path(wordlist: Path) -> Path:
    return wordlist.with_suffix(wordlist.suffix + ".state")


def load_state(wordlist: Path) -> dict:

    state_file = get_state_path(wordlist)

    if not state_file.exists():

        raise FileNotFoundError(

            f"Project file '{state_file}' not found."

        )

    with state_file.open(

        "r",

        encoding="utf-8",

    ) as f:

        state = json.load(f)


    # ---------------------------------
    # Migrate old project files
    # ---------------------------------

    if "project_type" not in state:

        print(
            "Old project state detected. Migrating..."
        )


        # Old password generator state

        if "keyword" in state:

            state["project_type"] = "password"

            state["resume"] = {

                "keyword": state.get(
                    "keyword",
                    0,
                ),

                "permutation": state.get(
                    "permutation",
                    0,
                ),

            }

            state.setdefault(
                "generated_total",
                0,
            )


        # Old exhaustive generator state

        elif "length" in state:

            state["project_type"] = "exhaustive"

            state["resume"] = {

                "length": state.get(
                    "length",
                    0,
                ),

                "index": state.get(
                    "index",
                    0,
                ),

            }

            state.setdefault(
                "generated_total",
                0,
            )


        else:

            raise ValueError(

                "Unknown old project format."

            )


        save_state(
            wordlist,
            state,
        )

        print(
            "Project upgraded successfully."
        )


    # ---------------------------------
    # Validate project
    # ---------------------------------

    if state["project_type"] == "password":

        required = [

            "keywords",

            "numbers",

            "symbols",

            "required_length",

            "repeat_words",

            "insert_numbers",

            "traversal",

            "max_candidates",

        ]


    elif state["project_type"] == "exhaustive":

        required = [

            "alphabet",

            "minimum_length",

            "maximum_length",

            "include_numbers",

            "include_symbols",

            "repeat_patterns",

            "insert_numbers",

            "traversal",

            "max_candidates",

        ]


    else:

        raise ValueError(

            "Unknown project type."

        )


    missing = [

        field

        for field in required

        if field not in state

    ]


    if missing:

        raise ValueError(

            f"Project file missing: {missing}"

        )


    return state


def save_state(
    wordlist: Path,
    state: dict,
):

    state_file = get_state_path(
        wordlist
    )

    with state_file.open(
        "w",
        encoding="utf-8",
    ) as f:

        json.dump(

            state,

            f,

            indent=4,

        )


