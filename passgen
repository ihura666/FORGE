def normalize_word(word: str) -> str:
    return word.strip().lower()


def is_allowed_length(candidate: str, minimum_length: int = 8, maximum_length: int = 20) -> bool:
    return minimum_length <= len(candidate) <= maximum_length


def get_permutations(word: str, max_perms: int | None = None) -> set[str]:
    """Generate permutations of a word's letters.

    When max_perms is None, this generates all permutations for the provided word.
    For very long inputs this can grow extremely large, so the caller can decide how
    much to generate via the optional limit.
    """
    if len(word) > 8 and max_perms is None:
        result = {word}
        result.add(word[::-1])
        for i in range(len(word) - 1):
            swapped = word[:i] + word[i+1] + word[i] + word[i+2:]
            result.add(swapped)
        return result

    perms = set()
    count = 0
    for perm in permutations(word):
        if max_perms is not None and count >= max_perms:
            break
        perms.add(''.join(perm))
        count += 1
    return perms

def get_fixed_length_permutations(
    characters: str,
    required_length: int,
    max_perms: int | None = None,
):
    """
    Generate permutations containing exactly required_length
    characters from the supplied character pool.
    """

    if not characters:
        return

    if required_length < 1:
        return

    if required_length > len(characters):
        return

    seen = set()
    count = 0

    for perm in permutations(characters, required_length):

        candidate = "".join(perm)

        if candidate in seen:
            continue

        seen.add(candidate)

        yield candidate

        count += 1

        if max_perms is not None and count >= max_perms:
            return

def interleave_char(word: str, char: str) -> list[str]:
    """Insert a character at all possible positions in a word."""
    results = []
    for i in range(len(word) + 1):
        results.append(word[:i] + char + word[i:])
    return results


def generate_numeric_sequences(numbers: list[str], length: int = 4) -> list[str]:
    """Generate ordered numeric sequences from the supplied alphabet."""
    if not numbers:
        return []
    if length <= 0:
        return [""]
    return ["".join(parts) for parts in product(numbers, repeat=length)]


def generate_number_interleavings(word: str, numbers: list[str], max_count: int = 10000) -> list[str]:
    """Create alternating letter/number patterns such as v0i1n2i3."""
    if not word or not numbers:
        return []

    sequences = []
    for seq_len in range(1, min(len(word), 4) + 1):
        for seq in generate_numeric_sequences(numbers, length=seq_len):
            pieces = []
            for index, char in enumerate(word):
                if index < len(seq):
                    pieces.append(char)
                    pieces.append(seq[index])
                else:
                    pieces.append(char)
            candidate = "".join(pieces)
            if candidate and is_allowed_length(candidate, 4, 30):
                sequences.append(candidate)

    # Also generate compact variants that interleave the digits between every character
    for idx in range(1, min(len(word), 4) + 1):
        for seq in generate_numeric_sequences(numbers, length=idx):
            candidate = "".join(
                char if i >= len(seq) else f"{char}{seq[i]}"
                for i, char in enumerate(word)
            )
            if candidate and is_allowed_length(candidate, 4, 30):
                sequences.append(candidate)

    # Explicitly emit compact patterns like v0i1n2i3 and V0I1N2I3.
    for index in range(1, min(len(word), 4) + 1):
        for seq in generate_numeric_sequences(numbers, length=index):
            compact = "".join(
                char if i >= len(seq) else f"{char}{seq[i]}"
                for i, char in enumerate(word)
            )
            if compact and len(compact) >= 4:
                sequences.append(compact)
                sequences.append(compact.upper())

    return list(dict.fromkeys(sequences))[:max_count]


def generate_interspersed_combos(word: str, items: list[str], depth: int = 3) -> list[str]:
    """Generate combinations with items interspersed throughout the word."""
    results = [word]
    
    # Single item insertions at multiple positions
    for item in items:
        for variant in interleave_char(word, item):
            results.append(variant)
            
            # Double insertions
            if depth > 1:
                for item2 in items:
                    for variant2 in interleave_char(variant, item2):
                        if is_allowed_length(variant2):
                            results.append(variant2)
                        
                        # Triple insertions
                        if depth > 2:
                            for item3 in items:
                                for variant3 in interleave_char(variant2, item3):
                                    if is_allowed_length(variant3):
                                        results.append(variant3)
    
    return results

def yield_number_insertions(
    word: str,
    numbers: list[str],
    required_length: int,
):
    """
    Generate one- and two-number insertions.
    """

    if not numbers:
        return

    seen = set()

    # Single insertion

    for number in numbers:

        for pos in range(len(word) + 1):

            candidate = (
                word[:pos]
                + number
                + word[pos:]
            )

            if len(candidate) != required_length:
                continue

            if candidate not in seen:

                seen.add(candidate)

                yield candidate

    # Double insertion

    for first in numbers:

        for second in numbers:

            for pos1 in range(len(word) + 1):

                temp = (
                    word[:pos1]
                    + first
                    + word[pos1:]
                )

                for pos2 in range(len(temp) + 1):

                    candidate = (
                        temp[:pos2]
                        + second
                        + temp[pos2:]
                    )

                    if len(candidate) != required_length:
                        continue

                    if candidate not in seen:

                        seen.add(candidate)

                        yield candidate

def yield_variants(
    word: str,
    numbers: list[str],
    symbols: list[str],
    required_length: int,
):
    """
    Generate Smart-mode variants with exactly required_length characters.

    Smart mode prefers:
    1. The original word when it already has the required length.
    2. Exact-length windows from longer words.
    3. Capitalization variants.
    4. Number and symbol combinations that fit exactly.
    """

    if not word or required_length < 1:
        return

    seen = set()

    def emit(candidate: str):
        candidate = candidate.strip()

        if not candidate:
            return

        if len(candidate) != required_length:
            return

        if candidate in seen:
            return

        seen.add(candidate)
        yield candidate

    # -------------------------------------------------
    # Base forms
    # -------------------------------------------------

    forms = [
        word,
        word.lower(),
        word.upper(),
        word.capitalize(),
        word.title(),
    ]

    # -------------------------------------------------
    # Exact-length base forms
    # -------------------------------------------------

    for form in forms:

        if len(form) == required_length:

            yield from emit(form)

        elif len(form) > required_length:

            # Sliding windows through the keyword.
            #
            # Example:
            # qwertyuiop
            # length = 5
            #
            # qwert
            # werty
            # erty u
            # ...

            for start in range(
                len(form) - required_length + 1
            ):

                candidate = form[
                    start:start + required_length
                ]

                yield from emit(candidate)

    # -------------------------------------------------
    # Number combinations
    # -------------------------------------------------

    for form in forms:

        if len(form) > required_length:
            continue

        remaining = required_length - len(form)

        if remaining <= 0:
            continue

        if numbers:

            # Numbers before the word
            for number in numbers:

                if len(number) == remaining:

                    yield from emit(
                        number + form
                    )

            # Numbers after the word
            for number in numbers:

                if len(number) == remaining:

                    yield from emit(
                        form + number
                    )

        # -------------------------------------------------
        # Symbol + number combinations
        # -------------------------------------------------

        if symbols and numbers and remaining >= 2:

            for symbol in symbols:

                for number in numbers:

                    if len(symbol) + len(number) != remaining:
                        continue

                    yield from emit(
                        form + symbol + number
                    )

                    yield from emit(
                        number + symbol + form
                    )

                    yield from emit(
                        form + number + symbol
                    )

                    yield from emit(
                        symbol + number + form
                    )

        # -------------------------------------------------
        # Symbol combinations
        # -------------------------------------------------

        if symbols:

            for symbol in symbols:

                if len(symbol) == remaining:

                    yield from emit(
                        form + symbol
                    )

                    yield from emit(
                        symbol + form
                    )

    # -------------------------------------------------
    # Exact-length combinations made from the keyword
    # -------------------------------------------------

    # This is deliberately limited to combinations that
    # preserve the original character order.

    if len(word) > required_length:

        for start in range(
            len(word) - required_length + 1
        ):

            fragment = word[
                start:start + required_length
            ]

            yield from emit(fragment)

            yield from emit(
                fragment.capitalize()
            )

            yield from emit(
                fragment.upper()
            )

    return


